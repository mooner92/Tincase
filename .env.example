# ── 필수 ────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"             # 스키마 파일 기준 상대경로 → prisma/dev.db · 운영: file:/data/db/worklog.db
STORAGE_ROOT="./storage"                   # 운영: /data
CF_ACCESS_TEAM="aidt-kei"
CF_ACCESS_AUD=""                           # Access 앱 생성 후 AUD 태그 (AU-02, Q-04)
TZ="Asia/Seoul"

# ── 선택 ────────────────────────────────────────────────
MAX_UPLOAD_BYTES="20971520"                # 20MB (ST-04)

# ── 개발 전용 (production에서 설정 시 기동 거부 — OPS-06) ──
# DEV_IDENTITY="mhchoi@kei.re.kr"          # Cloudflare 없이 로컬 개발 (AU-03)

# ── 사내 메신저 알림 (NT-01~14) ─────────────────────────────
# 비어 있으면 알림 기능 전체가 꺼진다. 실제 주소는 사내 문서 참조 (docs/integrations/messenger.md)
MESSENGER_URL=""                           # 예: http://messenger.example.com:12555
# ★ 실제로 팝업이 뜬다. 이 목록에 있는 사번에게만 나간다. 비면 아무에게도 안 간다
MESSENGER_ALLOWLIST=""                     # 테스트: "21963" · 전원: "*"
MESSENGER_SYSTEM_NAME="Tincase"
MESSENGER_SENDER_ID="TINCASE"
MESSENGER_SENDER_NAME="업무일지 수합"
MESSENGER_LINK_BASE=""                     # 알림 클릭 시 열릴 기준 주소 (사내망)
MESSENGER_URL_OPTION="WB=NEW,WA=EDGE"      # 사내 샘플 기본값. Edge 없는 PC가 있으면 WA=DEFAULT

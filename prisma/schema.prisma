// S-01 도메인 모델. 요구사항 ID는 docs/spec/01-domain-model.md 참조.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // slim 이미지의 openssl 부재로 엔진 감지가 1.1.x로 폴백하는 문제 방지 — 명시 고정
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Division {
  id        String  @id @default(cuid())
  slug      String  @unique // "AI_and_Public_Relations_Division" (정식)
  shortSlug String? @unique // "aiprd" — 정식 슬러그로 redirect (Q-18)
  nameKo    String  @unique
  nameEn    String
  /** 소속 본부 (조직도 3단계: 연구원 → 본부 → 실). 본부 직속이면 "한국환경연구원" */
  parentKo  String  @default("한국환경연구원")
  isActive  Boolean @default(false) // 온보딩된 부서만 true

  deadlineDow     Int     @default(4) // 마감 요일 1=월 … 7=일. 기본 목요일 (전사 마감 목 15:00보다 앞) — DM-10
  deadlineTime    String  @default("14:00") // "HH:mm" KST
  // 병합 규칙 (S-08 §6). 문법 없는 설정 3개 + 자연어 지침 1개.
  // 문법을 만들지 않는 이유: 실제 부서가 주고받는 규칙은 "순서: AI-홍보-시스템-도서관" 두 줄이었다.
  mergeCategories String  @default("") // 분류 순서, 쉼표 구분. 비면 제출자 순서
  mergeDedupe     Boolean @default(true) // 중복 묶기
  mergeDropNotes  Boolean @default(true) // 특이사항이 비면 3번 표 삭제
  mergeRuleText   String  @default("") // 담당자가 쓰는 자연어 지침 — 모델에 그대로 전달
  guideText       String  @default("") // 업로드 화면 작성 안내 (CP-21)

  // 취합게시판 제출 이력 (R-002 관찰) — 온보딩 우선순위 판단용. 운영자가 갱신 가능 (DM-15)
  boardStatus String @default("none") // "confirmed" | "unclear" | "none"
  boardNote   String @default("") // 관찰 근거 (제출일·특이사항)

  createdAt   DateTime     @default(now())
  users       User[]
  templates   Template[]
  submissions Submission[]
  mergeRuns   MergeRun[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique // Access 신원 대조 키. 소문자 (DM-01)
  name          String
  divisionId    String
  divisionRole  String   @default("member") // "member" | "lead"
  isOperator    Boolean  @default(false) // 최종 관리자 (AU-15)
  isCoordinator Boolean  @default(false) // 전사 총괄 (AU-16)
  isActive      Boolean  @default(true) // 삭제 금지, 비활성화만 (DM-03)
  onRoster      Boolean  @default(true) // 제출 대상 — 운영자가 관리 (DM-04)
  sortOrder     Int      @default(100)
  createdAt     DateTime @default(now())

  // 사내망 직접 접속용 비밀번호 인증 (AU-20). 외부는 Cloudflare Access가 담당
  passwordHash       String? // scrypt. null이면 아직 발급 전
  mustChangePassword Boolean   @default(true) // 초기 발급 비밀번호는 첫 로그인 시 변경 강제
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? // 무차별 대입 방어 (AU-23)

  division    Division     @relation(fields: [divisionId], references: [id])
  submissions Submission[]
  sessions    Session[]

  @@index([divisionId, isActive, onRoster, sortOrder])
}

// 사내망 로그인 세션 (AU-21). 쿠키에는 원문 토큰, DB에는 해시만 저장.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// 전역 주 달력 — 부서와 무관한 사실. deadline 컬럼 없음 (DM-11)
model WeekSlot {
  id          String   @id @default(cuid())
  isoKey      String   @unique // "2026-W33" (WS-09)
  label       String // "8월 2주차"
  year        Int
  month       Int
  weekOfMonth Int
  opensAt     DateTime // 월 00:00 KST (UTC 저장)
  createdAt   DateTime @default(now())

  submissions Submission[]
  mergeRuns   MergeRun[]

  @@index([opensAt])
}

model Submission {
  id         String  @id @default(cuid())
  divisionId String // = user.divisionId 업로드 시점 (DM-12)
  userId     String
  weekSlotId String
  version    Int // 1부터 (DM-05)
  isLatest   Boolean @default(true)

  filePath     String // STORAGE_ROOT 기준 상대경로 (ST-02)
  originalName String
  byteSize     Int
  sha256       String

  uploadedAt   DateTime @default(now())
  uploadedFrom String?

  division Division @relation(fields: [divisionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  weekSlot WeekSlot @relation(fields: [weekSlotId], references: [id])

  @@unique([userId, weekSlotId, version])
  @@index([divisionId, weekSlotId, isLatest]) // 격리 스코프 조회의 기본 축
}

// 부서별 마스터 양식 이력 (DM-14)
model Template {
  id         String   @id @default(cuid())
  divisionId String
  filePath   String
  sha256     String
  version    Int // 부서 내 1부터
  isActive   Boolean  @default(true) // 부서당 active 1개
  uploadedBy String // User.id
  uploadedAt DateTime @default(now())

  division Division @relation(fields: [divisionId], references: [id])

  @@unique([divisionId, version])
  @@index([divisionId, isActive])
}

// 전사 표준 양식 — 기획조정실이 배포하는 공통 원본 (부서 스코프 밖).
// 각 부서 담당자가 이걸 받아 자기 부서 부분만 남기고 부서 양식으로 등록한다.
model StandardTemplate {
  id         String   @id @default(cuid())
  filePath   String
  sha256     String
  version    Int      @unique
  isActive   Boolean  @default(true)
  note       String   @default("") // 출처·주차 등 메모
  uploadedBy String // User.id (operator)
  uploadedAt DateTime @default(now())

  @@index([isActive])
}

// Phase 2 선반영 (마이그레이션 1회 절약)
model MergeRun {
  id           String    @id @default(cuid())
  divisionId   String
  weekSlotId   String
  status       String // "running"|"succeeded"|"failed"
  outputPath   String?
  sourceIds    String // JSON: Submission id[]
  ruleSnapshot String // 실행 시점 규칙 원문 (DM-13)
  rowCounts    String?
  warnings     String? // JSON: string[]
  /** HM-26 — 검토 화면이 쓰는 정보 (합쳐진 행·모델 사용 여부·분류·미제출자). JSON */
  reviewJson   String?
  errorText    String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  division Division @relation(fields: [divisionId], references: [id])
  weekSlot WeekSlot @relation(fields: [weekSlotId], references: [id])

  @@index([divisionId, weekSlotId, startedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actor      String // 검증된 이메일 (AU-09)
  divisionId String?
  action     String // upload|download|download_zip|preview|merge|rule_update|template_update|reject|cross_division_read
  target     String?
  detail     String?

  @@index([at])
  @@index([divisionId, at])
}

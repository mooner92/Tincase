// S-01 도메인 모델. 요구사항 ID는 docs/spec/01-domain-model.md 참조.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  // slim 이미지의 openssl 부재로 엔진 감지가 1.1.x로 폴백하는 문제 방지 — 명시 고정
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Division {
  id        String  @id @default(cuid())
  slug      String  @unique // "AI_and_Public_Relations_Division" (정식)
  shortSlug String? @unique // "aiprd" — 정식 슬러그로 redirect (Q-18)
  nameKo    String  @unique
  nameEn    String
  /**
   * 소속 본부 (조직도 3단계: 연구원 → 본부 → 실). 본부 직속이면 "한국환경연구원"
   */
  parentKo  String  @default("한국환경연구원")
  isActive  Boolean @default(false) // 온보딩된 부서만 true

  deadlineDow     Int     @default(4) // 마감 요일 1=월 … 7=일. 기본 목요일 (전사 마감 목 15:00보다 앞) — DM-10
  deadlineTime    String  @default("14:00") // "HH:mm" KST
  // 병합 규칙 (S-08 §6). 문법 없는 설정 3개 + 자연어 지침 1개.
  // 문법을 만들지 않는 이유: 실제 부서가 주고받는 규칙은 "순서: AI-홍보-시스템-도서관" 두 줄이었다.
  mergeCategories String  @default("") // 분류 순서, 쉼표 구분. 비면 제출자 순서
  mergeDedupe     Boolean @default(true) // 중복 묶기
  mergeDropNotes  Boolean @default(true) // 특이사항이 비면 3번 표 삭제
  mergeRuleText   String  @default("") // 담당자가 쓰는 자연어 지침 — 모델에 그대로 전달
  /**
   * HM-33 — 「내용이 없다」는 뜻으로 보이는 낱말. 쉼표 구분. **비면 검사하지 않는다.**
   * 기본이 꺼짐인 이유: 이건 한 부서에서 실제로 겪은 일이라 전사 규칙이 아니다.
   * 찾기만 하고 **지우지 않는다** — 담당자 알림과 화면에 「확인해 주세요」로만 뜬다
   */
  emptyWords      String  @default("")
  /// HM-38 — 괄호로 감싸 적은 강조 표시. 병합이 떼어내고 「공유」로 바꾼다
  emphasisWords   String  @default("하이라이트")
  guideText       String  @default("") // 업로드 화면 작성 안내 (CP-21)

  // 취합게시판 제출 이력 (R-002 관찰) — 온보딩 우선순위 판단용. 운영자가 갱신 가능 (DM-15)
  boardStatus String @default("none") // "confirmed" | "unclear" | "none"
  boardNote   String @default("") // 관찰 근거 (제출일·특이사항)

  /**
   * NT-30 — 이 부서에 알림을 보낼 것인가. **기본값 false** —
   * 새 부서가 온보딩되자마자 모르는 사람에게 알림이 가면 안 된다.
   * 우리 부서에서 충분히 써 본 뒤 부서별로 하나씩 켠다
   */
  notifyEnabled Boolean @default(false)

  /**
   * RU-20 — **이 단위 아래**(본부라면 자기 문서 + 산하 실·팀)를 이어 붙이는 순서. Division.id의 JSON 배열.
   * 목록에 없는 단위는 ERP 순서(등록 순서)로 뒤에 붙는다 — 새로 켠 실이 순서에서 사라지지 않게.
   * 상하 관계는 따로 두지 않고 `parentKo`를 쓴다 — 인원 최신화(RS)가 이미 맞춰 주는 값이다
   */
  rollupOrder     String  @default("[]")
  /// RU-21 — 순서·편집 메모. **사람이 읽는 것**이고 순서는 목록이 정한다 (같은 입력 → 같은 순서)
  rollupNote      String  @default("")
  /// RU-10 — 이어 붙일 때 둘째 단위부터 새 쪽에서 시작한다
  rollupPageBreak Boolean @default(true)
  /**
   * RU-08 — 본부일 때 **본부 자기 문서**(본부 직속 인원이 쓴 것)도 이어 붙이는가.
   * 본부가 켜져 있으면 기본으로 넣는다. 본부 담당자가 산하 실 것만 모으는 본부는 끈다 (Q3)
   */
  rollupSelf      Boolean @default(true)

  createdAt    DateTime      @default(now())
  users        User[]
  templates    Template[]
  submissions  Submission[]
  mergeRuns    MergeRun[]
  notifyLogs   NotifyLog[]
  slotOpenings SlotOpening[]
  reportSubmissions ReportSubmission[]
  rollupRuns        RollupRun[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique // Access 신원 대조 키. 소문자 (DM-01)
  name          String
  divisionId    String
  divisionRole  String   @default("member") // "member" | "lead"
  isOperator    Boolean  @default(false) // 최종 관리자 (AU-15)
  isCoordinator Boolean  @default(false) // 전사 총괄 (AU-16)
  isActive      Boolean  @default(true) // 삭제 금지, 비활성화만 (DM-03)
  onRoster      Boolean  @default(true) // **집계 대상**. 제출 권한이 아니다 (DM-04, DM-16)
  /**
   * DM-16 — 집계에서 뺀 이유. "휴직" · "부서장" 등. onRoster=false일 때만 뜻이 있다.
   * 빼는 것과 그 이유를 같이 적어두지 않으면, 몇 주 뒤에 왜 뺐는지 아무도 모른다
   */
  rosterNote    String?
  /**
   * NT-01 — 사내 메신저 사번(RecvId). 없으면 알림을 보내지 않는다.
   * 이메일과 별개다 — 메신저는 사번으로만 사람을 찾는다
   */
  employeeNo    String?
  /**
   * RS-02 — ERP 인원 현황의 `직책` ("담당"·"실장"·"본부장"·"원장"…).
   * 역할(head)과 집계 제외를 여기서 **유도**한다. 값을 저장해 두는 이유는
   * 다음 동기화 때 «바뀌었는가»를 알기 위해서다 — 안 바뀌었으면 사람이 정한 값을 지킨다
   */
  jobTitle      String?
  /**
   * NT-20 — 알림 받기. 본인이 끌 수 있고 운영자도 바꿀 수 있다.
   * 끄면 마감 전 알림이 가지 않는다 — 제출 의무는 그대로다
   */
  notifyEnabled Boolean  @default(true)
  sortOrder     Int      @default(100)
  createdAt     DateTime @default(now())

  // 사내망 직접 접속용 비밀번호 인증 (AU-20). 외부는 Cloudflare Access가 담당
  passwordHash       String? // scrypt. null이면 아직 발급 전
  mustChangePassword Boolean   @default(true) // 초기 발급 비밀번호는 첫 로그인 시 변경 강제
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? // 무차별 대입 방어 (AU-23)

  division    Division     @relation(fields: [divisionId], references: [id])
  submissions Submission[]
  sessions    Session[]
  setupTokens SetupToken[]

  @@index([divisionId, isActive, onRoster, sortOrder])
}

// 사내망 로그인 세션 (AU-21). 쿠키에는 원문 토큰, DB에는 해시만 저장.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
  ip         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// 전역 주 달력 — 부서와 무관한 사실. deadline 컬럼 없음 (DM-11)
model WeekSlot {
  id          String   @id @default(cuid())
  isoKey      String   @unique // "2026-W33" (WS-09)
  label       String // "8월 2주차"
  year        Int
  month       Int
  weekOfMonth Int
  opensAt     DateTime // 월 00:00 KST (UTC 저장)
  createdAt   DateTime @default(now())

  // WS-18 — **이 주차만의 마감 예외.** 연휴로 전사 일정이 당겨질 때 쓴다.
  // 부서가 아니라 **주차**에 붙는 이유가 둘이다:
  //   1. 다음 주로 샐 수 없다. 부서 설정을 고쳤다 되돌리는 방식은 되돌리는 일이
  //      사람 기억에 남고, 잊으면 그 다음 주 마감이 통째로 틀린다 (HM-44와 같은 이유).
  //   2. 지난 주차가 안 흔들린다. 부서 설정은 과거 주차의 마감 표시까지 소급해 바꾼다.
  // 연휴 공지는 전사 대상이라 부서별이 아니라 주차별인 것이 뜻에도 맞는다.
  deadlineDowOverride  Int? //    1=월 … 7=일. null이면 부서 기본값
  deadlineTimeOverride String? // "HH:mm" KST. null이면 부서 기본값
  /// 왜 당겼나 — 화면에 그대로 보인다. 이유 없는 예외는 두지 않는다
  deadlineNote         String?

  submissions  Submission[]
  mergeRuns    MergeRun[]
  notifyLogs   NotifyLog[]
  slotOpenings SlotOpening[]
  reportSubmissions ReportSubmission[]
  rollupRuns        RollupRun[]

  @@index([opensAt])
}

model Submission {
  id         String  @id @default(cuid())
  divisionId String // = user.divisionId 업로드 시점 (DM-12)
  userId     String
  weekSlotId String
  version    Int // 1부터 (DM-05)
  isLatest   Boolean @default(true)

  filePath     String // STORAGE_ROOT 기준 상대경로 (ST-02)
  originalName String
  byteSize     Int
  sha256       String

  uploadedAt   DateTime @default(now())
  uploadedFrom String?
  /**
   * WA-04 — 사람이 만든 hwp인지 시스템이 만든 것인지 (통계·디버깅용).
   * 결과물 자체는 구별되지 않아야 하므로 처리 경로는 완전히 동일하다
   */
  origin       String   @default("upload") // "upload" | "web"

  division Division @relation(fields: [divisionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  weekSlot WeekSlot @relation(fields: [weekSlotId], references: [id])

  @@unique([userId, weekSlotId, version])
  @@index([divisionId, weekSlotId, isLatest]) // 격리 스코프 조회의 기본 축
}

// 부서별 마스터 양식 이력 (DM-14)
model Template {
  id         String   @id @default(cuid())
  divisionId String
  filePath   String
  sha256     String
  version    Int // 부서 내 1부터
  isActive   Boolean  @default(true) // 부서당 active 1개
  uploadedBy String // User.id
  uploadedAt DateTime @default(now())

  division Division @relation(fields: [divisionId], references: [id])

  @@unique([divisionId, version])
  @@index([divisionId, isActive])
}

// 전사 표준 양식 — 기획조정실이 배포하는 공통 원본 (부서 스코프 밖).
// 각 부서 담당자가 이걸 받아 자기 부서 부분만 남기고 부서 양식으로 등록한다.
model StandardTemplate {
  id         String   @id @default(cuid())
  filePath   String
  sha256     String
  version    Int      @unique
  isActive   Boolean  @default(true)
  note       String   @default("") // 출처·주차 등 메모
  uploadedBy String // User.id (operator)
  uploadedAt DateTime @default(now())

  @@index([isActive])
}

// Phase 2 선반영 (마이그레이션 1회 절약)
/// DM-20 — 담당자가 **그 주차 마감을 잠시 연** 기록 (TACP-18).
/// 부서·주차마다 하나. 늦게 낸 사람이 **본인 이름으로** 낼 수 있게 하는 유일한 길이다.
/// AU-30 — **비밀번호 설정 링크** (1회용).
///
/// 평문 비밀번호를 아예 만들지 않기 위한 것이다. 예전에는 운영자가 임시 비밀번호를
/// 화면에서 보고 사람마다 옮겨 적었는데, 그러면 «남의 비밀번호를 아는 사람»이 생기고
/// 100명이면 100번 옮겨야 한다.
///
/// **링크를 보내는 것만으로는 기존 비밀번호가 바뀌지 않는다.** 쓰는 순간에만 바뀐다 —
/// 그래서 이미 쓰고 있는 사람에게 잘못 보내도 그 사람은 아무 영향을 받지 않는다.
model SetupToken {
  id        String    @id @default(cuid())
  userId    String
  /// 원문은 어디에도 저장하지 않는다 (세션 토큰과 같은 방식)
  tokenHash String    @unique
  expiresAt DateTime
  /// 쓴 시각. 한 번 쓰면 죽는다
  usedAt    DateTime?
  /// 누가 보냈나 — 계정 관련 행위에는 언제나 이름이 붙는다
  createdBy String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SlotOpening {
  id         String   @id @default(cuid())
  divisionId String
  weekSlotId String
  /// 이 시각까지 열려 있다. 「지금 닫기」는 이 값을 현재로 당긴다
  openUntil  DateTime
  /// 누가 열었나 — 예외에는 언제나 이름이 붙는다
  openedBy   String
  openedAt   DateTime @default(now())

  division Division @relation(fields: [divisionId], references: [id])
  weekSlot WeekSlot @relation(fields: [weekSlotId], references: [id])

  @@unique([divisionId, weekSlotId])
}

model MergeRun {
  id           String    @id @default(cuid())
  divisionId   String
  weekSlotId   String
  status       String // "running"|"succeeded"|"failed"
  outputPath   String?
  sourceIds    String // JSON: Submission id[]
  ruleSnapshot String // 실행 시점 규칙 원문 (DM-13)
  rowCounts    String?
  warnings     String? // JSON: string[]
  /**
   * HM-26 — 검토 화면이 쓰는 정보 (합쳐진 행·모델 사용 여부·분류·미제출자). JSON
   */
  reviewJson   String?
  errorText    String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  division Division @relation(fields: [divisionId], references: [id])
  weekSlot WeekSlot @relation(fields: [weekSlotId], references: [id])

  @@index([divisionId, weekSlotId, startedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actor      String // 검증된 이메일 (AU-09)
  divisionId String?
  action     String // upload|download|download_zip|preview|merge|rule_update|template_update|reject|cross_division_read
  target     String?
  detail     String?

  @@index([at])
  @@index([divisionId, at])
}

/**
 * NT-12 — 보낸 알림의 기록. 같은 (부서, 주차, 종류)로 두 번 보내지 않기 위한 자물쇠이자
 * "왜 안 왔지"를 나중에 풀기 위한 근거다
 */
model NotifyLog {
  id         String   @id @default(cuid())
  divisionId String
  weekSlotId String
  /**
   * "deadline_1h" 등
   */
  kind       String
  /**
   * JSON: 실제로 보낸 사번 목록
   */
  recipients String
  /**
   * JSON: 걸러진 대상·오류 등
   */
  detail     String?
  sentAt     DateTime @default(now())

  division Division @relation(fields: [divisionId], references: [id])
  weekSlot WeekSlot @relation(fields: [weekSlotId], references: [id])

  @@unique([divisionId, weekSlotId, kind])
  @@index([sentAt])
}

/**
 * RU-01 — 위로 올린 **제출**. 실·팀 → 본부(`unit`), 본부 → 총괄(`hq`).
 *
 * 그 시점 병합본의 **사본**을 가리킨다 (RU-02). 하위가 다시 병합하거나 고쳐도 위가 보고 있던
 * 문서는 바뀌지 않는다 — 새 판을 올리려면 다시 제출한다. 다시 내면 새 행이 생기고, 가장 최근의
 * 취소되지 않은 행이 「지금 제출된 것」이다. 행은 지우지 않는다 — 언제 무엇을 올렸는지가 남는다.
 */
model ReportSubmission {
  id          String    @id @default(cuid())
  /// "unit" = 실·팀이 위로 · "hq" = 본부가 총괄로
  level       String
  divisionId  String
  weekSlotId  String
  /// 사본 (STORAGE_ROOT 기준). 원본 병합본 경로를 가리키지 않는다 — 원본은 다시 병합하면 덮인다
  filePath    String
  sha256      String
  byteSize    Int
  /// 어디서 나왔나 — unit: MergeRun.id · hq: RollupRun.id · 지난 자료 적재(RU-44): null
  sourceRunId String?
  /// "app" | "import" (RU-44 — 테스트 서버에 지난 자료를 넣은 것)
  origin      String    @default("app")
  submittedBy String // User.id
  submittedAt DateTime  @default(now())
  /// RU-03 — 제출 취소. 취소한 행은 「지금 제출된 것」에서 빠진다
  withdrawnAt DateTime?
  withdrawnBy String?

  division Division @relation(fields: [divisionId], references: [id])
  weekSlot WeekSlot @relation(fields: [weekSlotId], references: [id])

  @@index([weekSlotId, level, divisionId, submittedAt])
}

/**
 * RU-10 — 본부(`hq`)·전사(`org`) 이어 붙이기 한 번. 실·팀 병합(MergeRun)과 따로 둔다 —
 * 연구 본부처럼 **같은 부서가 실·팀 병합과 본부 병합을 둘 다** 가질 수 있어서, 한 표에 두면
 * 「그 부서의 최근 병합」이 어느 쪽인지 갈린다.
 */
model RollupRun {
  id          String    @id @default(cuid())
  /// "hq" | "org"
  level       String
  /// hq: 본부 Division.id · org: null (전사는 어느 부서의 것도 아니다)
  divisionId  String?
  weekSlotId  String
  /// "running" | "succeeded" | "failed"
  status      String
  outputPath  String?
  /// 이어 붙인 ReportSubmission.id — **붙인 순서 그대로** (JSON). 「바뀜」 판정이 이걸 본다
  inputIds    String
  /// 단위별 결과 — [{name, divisionId, submissionId, rows:{a,p,n}, emphasis}] (JSON)
  unitsJson   String?
  warnings    String?
  errorText   String?
  createdBy   String // User.id
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  division Division? @relation(fields: [divisionId], references: [id])
  weekSlot WeekSlot  @relation(fields: [weekSlotId], references: [id])

  @@index([level, divisionId, weekSlotId, startedAt])
}

/** RU-20·21 — 전사 단계의 순서와 메모 (한 행). 본부 단계는 Division.rollupOrder에 있다 */
model OrgRollupSetting {
  id        String   @id @default("org")
  /// 본부·본부 밖 단위의 Division.id 순서 (JSON)
  order     String   @default("[]")
  note      String   @default("")
  pageBreak Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// S-01 도메인 모델. 요구사항 ID는 docs/spec/01-domain-model.md 참조.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Division {
  id            String   @id @default(cuid())
  slug          String   @unique // "AI_and_Public_Relations_Division" (정식)
  shortSlug     String?  @unique // "aiprd" — 정식 슬러그로 redirect (Q-18)
  nameKo        String   @unique
  nameEn        String
  isActive      Boolean  @default(false) // 온보딩된 부서만 true

  deadlineDow   Int      @default(2) // 마감 요일 1=월 … 7=일 (DM-10)
  deadlineTime  String   @default("14:00") // "HH:mm" KST
  mergeRuleText String   @default("") // 부서 병합 규칙 (S-08 §6, Phase 2)
  guideText     String   @default("") // 업로드 화면 작성 안내 (CP-21)

  createdAt   DateTime     @default(now())
  users       User[]
  templates   Template[]
  submissions Submission[]
  mergeRuns   MergeRun[]
}

model User {
  id            String  @id @default(cuid())
  email         String  @unique // Access 신원 대조 키. 소문자 (DM-01)
  name          String
  divisionId    String
  divisionRole  String  @default("member") // "member" | "lead"
  isOperator    Boolean @default(false) // 최종 관리자 (AU-15)
  isCoordinator Boolean @default(false) // 전사 총괄 (AU-16)
  isActive      Boolean @default(true) // 삭제 금지, 비활성화만 (DM-03)
  onRoster      Boolean @default(true) // 제출 대상 — 운영자가 관리 (DM-04)
  sortOrder     Int     @default(100)
  createdAt     DateTime @default(now())

  division    Division     @relation(fields: [divisionId], references: [id])
  submissions Submission[]

  @@index([divisionId, isActive, onRoster, sortOrder])
}

// 전역 주 달력 — 부서와 무관한 사실. deadline 컬럼 없음 (DM-11)
model WeekSlot {
  id          String   @id @default(cuid())
  isoKey      String   @unique // "2026-W33" (WS-09)
  label       String // "8월 2주차"
  year        Int
  month       Int
  weekOfMonth Int
  opensAt     DateTime // 월 00:00 KST (UTC 저장)
  createdAt   DateTime @default(now())

  submissions Submission[]
  mergeRuns   MergeRun[]

  @@index([opensAt])
}

model Submission {
  id           String   @id @default(cuid())
  divisionId   String // = user.divisionId 업로드 시점 (DM-12)
  userId       String
  weekSlotId   String
  version      Int // 1부터 (DM-05)
  isLatest     Boolean  @default(true)

  filePath     String // STORAGE_ROOT 기준 상대경로 (ST-02)
  originalName String
  byteSize     Int
  sha256       String

  uploadedAt   DateTime @default(now())
  uploadedFrom String?

  division Division @relation(fields: [divisionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  weekSlot WeekSlot @relation(fields: [weekSlotId], references: [id])

  @@unique([userId, weekSlotId, version])
  @@index([divisionId, weekSlotId, isLatest]) // 격리 스코프 조회의 기본 축
}

// 부서별 마스터 양식 이력 (DM-14)
model Template {
  id         String   @id @default(cuid())
  divisionId String
  filePath   String
  sha256     String
  version    Int // 부서 내 1부터
  isActive   Boolean  @default(true) // 부서당 active 1개
  uploadedBy String // User.id
  uploadedAt DateTime @default(now())

  division Division @relation(fields: [divisionId], references: [id])

  @@unique([divisionId, version])
  @@index([divisionId, isActive])
}

// Phase 2 선반영 (마이그레이션 1회 절약)
model MergeRun {
  id           String    @id @default(cuid())
  divisionId   String
  weekSlotId   String
  status       String // "running"|"succeeded"|"failed"
  outputPath   String?
  sourceIds    String // JSON: Submission id[]
  ruleSnapshot String // 실행 시점 규칙 원문 (DM-13)
  rowCounts    String?
  warnings     String? // JSON: string[]
  errorText    String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  division Division @relation(fields: [divisionId], references: [id])
  weekSlot WeekSlot @relation(fields: [weekSlotId], references: [id])

  @@index([divisionId, weekSlotId, startedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actor      String // 검증된 이메일 (AU-09)
  divisionId String?
  action     String // upload|download|download_zip|preview|merge|rule_update|template_update|reject|cross_division_read
  target     String?
  detail     String?

  @@index([at])
  @@index([divisionId, at])
}
